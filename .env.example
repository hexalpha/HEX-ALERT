# Required bootstrap settings
POSTGRES_DB=hexalert
POSTGRES_USER=hexalert
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+asyncpg://hexalert:change-me@db:5432/hexalert

# Optional Redis (not required for operation)
REDIS_URL=

# AI defaults; dashboard preferences are saved in the persistent encrypted runtime store.
# local_gguf, openai, gemini, groq, ollama, custom, or disabled.
LOCAL_GGUF_URL=http://llm:8081
LOCAL_GGUF_MODEL=/models/CyberSecurity.gguf
AI_PROVIDER=local_gguf
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
AI_MODEL=CyberSecurity.gguf

# Collection and API settings
NVD_API_KEY=
GITHUB_TOKEN=
POLL_JOBS_MINUTES=45
POLL_NEWS_MINUTES=20
POLL_CVE_MINUTES=12
CRITICAL_CVE_THRESHOLD=8.0
POLL_TECH_MINUTES=120
POLL_THREATS_MINUTES=30
DAILY_DIGEST_HOUR=8
DAILY_DIGEST_TIMEZONE=Asia/Kolkata
APP_TIMEZONE=Asia/Kolkata
TIME_FORMAT=12h
AUTO_BACKUP_DAILY=true
BACKUP_HOUR_UTC=3
API_HOST=127.0.0.1
API_PORT=8080
ADMIN_USER_IDS=
DASHBOARD_API_KEY=replace-with-a-long-random-value
SESSION_SECRET=replace-with-a-different-long-random-value
TEST_MODE=true
LOG_LEVEL=INFO
REQUEST_TIMEOUT_SECONDS=20

# Public RSS sources; comma-separated URLs. Respect each publisher's terms.
NEWS_FEEDS=https://feeds.feedburner.com/TheHackersNews,https://www.bleepingcomputer.com/feed/,https://www.cisa.gov/cybersecurity-advisories/all.xml
THREAT_FEEDS=https://www.cisa.gov/cybersecurity-advisories/all.xml
JOB_FEEDS=
JOB_FRESH_HOURS=24
JOB_ACCEPTABLE_DAYS=7
JOB_LOCATION_PRIORITIES=Remote,Remote India,India,Rajasthan,Jaipur,Delhi,Delhi NCR,Gurugram,Gurgaon,Noida
HIGH_FIT_JOB_THRESHOLD=75
TECH_FEEDS=https://github.blog/category/security/feed/,https://hnrss.org/newest?q=cybersecurity
